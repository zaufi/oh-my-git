#!/usr/bin/env bash
#
# SPDX-FileCopyrightText: 2026 Alex Turbov <i.zaufi@gmail.com>
# SPDX-License-Identifier: CC0-1.0
#
# Select a worktree directory interactively with `sk`; run with `-h` for help.
#

set -euo pipefail

if (( BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 3) )); then
    printf 'git-select-worktree: Bash 5.3 or newer is required (found %s)\n' "${BASH_VERSION}" >&2
    exit 1
fi

print_help() {
    cat <<'EOF'
git-select-worktree [-m|--multi] [--prompt <text>] [-h|--help]

Show worktrees in `sk` (skim) and print the selected worktree directory to stdout.
This is convenient for shell aliases such as:

  alias cdwt='cd $(git select-worktree)'

Options:
  -m, --multi      Enable multi-select mode in `sk` (skim).
  --prompt <text>  Set the `sk` prompt text.
  -h, --help       Show this help text and exit.

Colors (any Git color value, e.g. `"#e0a040" "" italic`):
  color.selectWorktree.header    Header line (default: bold green).
  color.selectWorktree.path      Worktree path (default: cyan).
  color.selectWorktree.clean     Branch of a clean worktree (default: green).
  color.selectWorktree.dirty     Branch of a dirty worktree (default: yellow).
  color.selectWorktree.detached  Detached HEAD (default: red).
EOF
}

# NOTE The `pad_right*` functions set `REPLY`, so call them as `${| pad_right …; }`.
pad_right_by_width() {
    local value=${1}
    local -i value_width=${2}
    local -i width=${3}
    local -i padding=$((width - value_width))

    printf -v REPLY '%s%*s' "${value}" $(( padding > 0 ? padding : 0 )) ''
}

pad_right() {
    local value=${1}
    local -i width=${2}

    pad_right_by_width "${value}" "${#value}" "${width}"
}

append_worktree() {
    local path=${1}
    local branch=${2}
    local clean_color=${3}
    local dirty_color=${4}
    local detached_color=${5}
    local -n paths_ref=${6}
    local -n branches_ref=${7}
    local -n branch_colors_ref=${8}
    local -n max_path_length_ref=${9}
    local -n max_branch_length_ref=${10}
    local branch_color=

    if [[ -z ${path} ]]; then
        return
    fi

    if [[ -z ${branch} ]]; then
        branch=-
    fi

    if [[ ${branch} == detached ]]; then
        branch_color=${detached_color}
    elif [[ -n ${ git -C "${path}" status --porcelain; } ]]; then
        branch_color=${dirty_color}
    else
        branch_color=${clean_color}
    fi

    paths_ref+=("${path}")
    branches_ref+=("${branch}")
    branch_colors_ref+=("${branch_color}")

    if (( ${#path} > max_path_length_ref )); then
        max_path_length_ref=${#path}
    fi

    if (( ${#branch} > max_branch_length_ref )); then
        max_branch_length_ref=${#branch}
    fi
}

format_worktrees() {
    declare -r branch_header=ʙʀᴀɴᴄʜ
    declare -r path_header=ᴘᴀᴛʜ
    declare -ri path_header_width=4
    declare -r reset=$'\033[0m'
    declare -ri branch_header_width=6
    declare branch=
    declare index=
    declare line=
    declare path=
    declare -a branches=()
    declare -a paths=()
    declare -a branch_colors=()
    declare -i max_branch_length=${branch_header_width}
    declare -i max_path_length=${path_header_width}

    while IFS= read -r line; do
        if [[ -z ${line} ]]; then
            append_worktree \
                "${path}" \
                "${branch}" \
                "${clean_color}" \
                "${dirty_color}" \
                "${detached_color}" \
                paths \
                branches \
                branch_colors \
                max_path_length \
                max_branch_length
            path=
            branch=
            continue
        fi

        case "${line}" in
            "worktree "*)
                path=${line#worktree }
                ;;
            "branch "*)
                branch=${line#branch }
                branch=${branch#refs/heads/}
                ;;
            detached)
                branch=detached
                ;;
        esac
    done

    append_worktree \
        "${path}" \
        "${branch}" \
        "${clean_color}" \
        "${dirty_color}" \
        "${detached_color}" \
        paths \
        branches \
        branch_colors \
        max_path_length \
        max_branch_length

    printf '\t%s%s  %s%s\n' \
        "${header_color}" "${| pad_right_by_width "${path_header}" "${path_header_width}" "${max_path_length}"; }" \
        "${| pad_right_by_width "${branch_header}" "${branch_header_width}" "${max_branch_length}"; }" "${reset}"

    for index in "${!paths[@]}"; do
        printf '%s\t%s%s%s  %s%s%s\n' \
            "${paths[${index}]}" \
            "${path_color}" "${| pad_right "${paths[${index}]}" "${max_path_length}"; }" "${reset}" \
            "${branch_colors[${index}]}" "${| pad_right "${branches[${index}]}" "${max_branch_length}"; }" "${reset}"
    done
}

declare -a skim_options=()
declare -i multi_select=0
declare selector_prompt=
declare parsed_options=

if ! parsed_options=${ getopt --options mh --longoptions multi,prompt:,help --name git-select-worktree -- "${@}"; }; then
    print_help >&2
    exit 2
fi
eval set -- "${parsed_options}"

while (( ${#} > 0 )); do
    case "${1}" in
        -m|--multi)
            skim_options+=(-m)
            multi_select=1
            shift
            ;;
        --prompt)
            selector_prompt="${2}"
            shift 2
            ;;
        -h|--help)
            print_help
            exit 0
            ;;
        --)
            shift
            break
            ;;
    esac
done

if (( ${#} > 0 )); then
    printf 'git-select-worktree: unexpected argument: %s\n' "${1}" >&2
    print_help >&2
    exit 2
fi

if [[ -z ${selector_prompt} ]]; then
    if (( multi_select )); then
        selector_prompt=' Select work trees〉'
    else
        selector_prompt=' Select a work tree〉'
    fi
fi

declare header_color=
declare path_color=
declare clean_color=
declare dirty_color=
declare detached_color=

# NOTE Read colors here, not in `format_worktrees`, so an invalid value aborts the script.
header_color=${ git config --get-color color.selectWorktree.header 'bold green'; }
path_color=${ git config --get-color color.selectWorktree.path cyan; }
clean_color=${ git config --get-color color.selectWorktree.clean green; }
dirty_color=${ git config --get-color color.selectWorktree.dirty yellow; }
detached_color=${ git config --get-color color.selectWorktree.detached red; }

declare -i terminal_lines
declare -i worktree_count
declare -i selector_height
declare selector_output=
declare -i selector_status
declare -a worktree_lines=()

mapfile -t worktree_lines < <(git worktree list --porcelain | format_worktrees)
worktree_count=$((${#worktree_lines[@]} - 1))
if (( worktree_count == 0 )); then
    exit 0
fi

terminal_lines=${LINES:-${ tput lines; }}
terminal_lines=$(( terminal_lines - 1 ))  # Leave one to not overlap the prompt
worktree_count=$(( worktree_count + 6 ))  # 6 lines occupied by `sk` TUI ;-)
selector_height=$(( worktree_count < terminal_lines ? worktree_count : terminal_lines ))

set +e
selector_output=${
    printf '%s\n' "${worktree_lines[@]}" \
      | sk "${skim_options[@]}" \
          --ansi \
          --border rounded \
          --height "${selector_height}" \
          --delimiter $'\t' \
          --header-lines 1 \
          --prompt "${selector_prompt}" \
          --bind 'ctrl-q:ignore' \
          --nth 1 \
          --with-nth 2
}
selector_status=${?}
set -e

if (( selector_status == 130 )); then
    exit 0
fi

if (( selector_status != 0 )); then
    exit "${selector_status}"
fi

cut -f 1 <<< "${selector_output}"
